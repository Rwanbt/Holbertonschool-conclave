# Copie ce fichier en .env (local uniquement) et remplace la valeur ci-dessous
# par ta clé MiniMax. .env est ignoré par git : la clé ne part jamais du serveur.
MINIMAX_API_KEY=replace_with_your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
FRONTEND_ORIGIN=http://localhost:5173

# Optionnel — budget de sortie court et délai réseau de l'appel MiniMax.
# MINIMAX_MAX_OUTPUT_TOKENS=300

# Palier 3 — boucle agent : nombre maximal d'appels MiniMax (>= 1).
MINIMAX_MAX_TOOL_ROUNDS=3

# Palier 3 — tarifs ESTIMATIFS MiniMax-M3 (USD / 1M jetons), standard <=512K,
# vérifiés le 19/08/2026 via des agrégateurs tiers (OpenRouter, TokenMix,
# TokenCost) ; la promo de lancement appliquée est 0.30 / 1.20. Estimatifs et
# configurables : mets 0.0 (ou retire) pour laisser estimated_cost_usd à null.
MINIMAX_INPUT_USD_PER_MILLION=0.30
MINIMAX_OUTPUT_USD_PER_MILLION=1.20

# Palier 3 — outils désactivés, séparés par des virgules. Modifiable uniquement
# via .env puis redémarrage du serveur (jamais via un endpoint public).
# Exemple : DISABLED_TOOLS=measure_current_document
DISABLED_TOOLS=
