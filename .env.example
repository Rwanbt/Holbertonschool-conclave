# CONCLAVE — configuration (copie vers .env, jamais commité).
#
# Le backend démarre SANS aucune clé LLM : en production, tous les utilisateurs
# fournissent leur propre clé BYOK dans l'interface. Les clés serveur ci-dessous
# sont réservées au DEV / smoke test et sont désactivées par défaut.

# ---------------------------------------------------------------------------
# Plateforme
# ---------------------------------------------------------------------------

# Origines CORS autorisées, séparées par des virgules. Jamais « * ».
# FRONTEND_ORIGIN est conservé pour compatibilité ; FRONTEND_ORIGINS fait foi.
FRONTEND_ORIGINS=http://localhost:5173

# Base SQLite durable (créée au démarrage). En production, MONTER UN VOLUME
# persistant sur ce chemin : SQLite est mono-instance, jamais un filesystem
# éphémère.
DATABASE_PATH=./data/conclave.db

# Secret de signature des cookies de session. Si vide, une clé aléatoire par
# processus est utilisée : les sessions sont invalidées au redémarrage.
SESSION_COOKIE_SECRET=

# Plafonds : analyses simultanées globales et par session.
MAX_CONCURRENT_ANALYSES=3
MAX_ANALYSES_PER_SESSION=5
QUEUED_ANALYSIS_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Fournisseurs — clés serveur DEV / SMOKE UNIQUEMENT
# ---------------------------------------------------------------------------
# En production, laisser `false` : aucun fallback silencieux vers la clé du
# propriétaire n'est jamais tenté. Si une clé serveur est fournie, elle n'est
# utilisée que lorsque `true` est explicite (dev local ou smoke tests).
ALLOW_SERVER_PROVIDER_CREDENTIALS=false

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Garde-fous agentiques (valeurs de référence)
# ---------------------------------------------------------------------------

# Tours d'outils par expert, budget de sortie des JSON structurés.
AGENT_MAX_ROUNDS=5
EXPERT_MAX_OUTPUT_TOKENS=1500
STRUCTURED_REPAIR_ATTEMPTS=2

# Délais (secondes).
EXPERT_TIMEOUT_SECONDS=90
ARBITER_TIMEOUT_SECONDS=45
ANALYSIS_TIMEOUT_SECONDS=180

# Outils désactivés à l'initialisation d'une base NEUVE (préférences réelles
# par session ensuite).
DISABLED_TOOLS=

# ---------------------------------------------------------------------------
# Streaming SSE
# ---------------------------------------------------------------------------
SSE_POLL_INTERVAL_MS=100
SSE_KEEPALIVE_SECONDS=10
STREAM_MAX_DRAFT_CHARS=4000
STREAM_DELTA_BATCH_CHARS=16
STREAM_FLUSH_INTERVAL_MS=50

# ---------------------------------------------------------------------------
# Tarifs ESTIMATIFS MiniMax (USD / 1M jetons) — 0.0 = non configuré, le coût
# reste alors null et n'empêche jamais une analyse.
# ---------------------------------------------------------------------------
MINIMAX_INPUT_USD_PER_MILLION=0.30
MINIMAX_OUTPUT_USD_PER_MILLION=1.20

# ---------------------------------------------------------------------------
# OAuth officiel (Google Gemini uniquement)
# ---------------------------------------------------------------------------
# CONCLAVE n'implémente QUE l'OAuth officiellement supporté pour l'inférence :
# Google Gemini (l'API Generative Language accepte un jeton OAuth 2.0). Les
# OAuth ChatGPT/Codex et GitHub Copilot reposent sur des endpoints non publics
# et sont volontairement ABSENTS (cf. plan §14/§44). Sans client ci-dessous,
# l'option OAuth est simplement indisponible dans l'interface.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/oauth/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/generative-language
OAUTH_FRONTEND_REDIRECT=http://localhost:5173
