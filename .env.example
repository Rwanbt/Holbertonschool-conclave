# Copie ce fichier en .env (local uniquement) et remplace la valeur ci-dessous
# par ta clé MiniMax. .env est ignoré par git : la clé ne part jamais du serveur.
MINIMAX_API_KEY=replace_with_your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
FRONTEND_ORIGIN=http://localhost:5173

# Optionnel — budget de sortie court et délai réseau de l'appel MiniMax.
# MINIMAX_MAX_OUTPUT_TOKENS=300

# Palier 3 — boucle agent : nombre maximal d'appels MiniMax (>= 1).
MINIMAX_MAX_TOOL_ROUNDS=3

# Palier 3 — tarifs ESTIMATIFS MiniMax-M3 (USD / 1M jetons), standard <=512K,
# vérifiés le 19/08/2026 via des agrégateurs tiers (OpenRouter, TokenMix,
# TokenCost) ; la promo de lancement appliquée est 0.30 / 1.20. Estimatifs et
# configurables : mets 0.0 (ou retire) pour laisser estimated_cost_usd à null.
MINIMAX_INPUT_USD_PER_MILLION=0.30
MINIMAX_OUTPUT_USD_PER_MILLION=1.20

# Palier 3 — outils désactivés à la création d'une base SQLite NEUVE, séparés
# par des virgules. Ensuite, la table tool_states est la source de vérité :
# utilise la commande POST /api/tool-commands (`/tools enable|disable <nom>`).
# Exemple : DISABLED_TOOLS=measure_current_document
DISABLED_TOOLS=

# Palier 4 — persistance SQLite des analyses (créé son dossier, gitignoré).
DATABASE_PATH=./data/conclave.db

# Palier 4 — boucle des experts : nombre maximal de tours d'outils par expert,
# et budget de sortie des JSON structurés (AgentOutput/ArbiterVerdict sont
# volumineux : 300 jetons ne suffisent pas).
AGENT_MAX_ROUNDS=5
EXPERT_MAX_OUTPUT_TOKENS=1500

# Palier 4 — garde-fous de temps (secondes). Valeurs de référence de la démo.
EXPERT_TIMEOUT_SECONDS=30
ARBITER_TIMEOUT_SECONDS=20
ANALYSIS_TIMEOUT_SECONDS=60

# Palier 4 — streaming natif MiniMax-M3 (carte bonus). Le modèle répond via
# l'enveloppe <LIVE_RESPONSE>…</LIVE_RESPONSE><FINAL_JSON>…</FINAL_JSON>.
# Polling SSE (ms), intervalle keep-alive (s), plafond du brouillon live (chars)
# et taille de paquet des événements delta (chars).
SSE_POLL_INTERVAL_MS=100
SSE_KEEPALIVE_SECONDS=10
STREAM_MAX_DRAFT_CHARS=4000
STREAM_DELTA_BATCH_CHARS=32
